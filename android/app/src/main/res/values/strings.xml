    <string name="fault_cfs_check_path">Open the box lid and check the filament path from the spool to the connector and the tube to the head.</string>
    <string name="fault_101_title">AI camera: “spaghetti”</string>
    <string name="fault_101_what">The AI camera decided the model came loose or the print turned into a tangle of strands, and paused the print.</string>
    <string name="fault_101_todo">Check the print on the camera. If it looks fine, resume. False alarms: adjust sensitivity or turn off AI detection on the printer screen.</string>
    <string name="fault_103_title">AI camera: print defect</string>
    <string name="fault_103_what">The AI camera spotted a defect and paused the print.</string>
    <string name="fault_103_todo">Check the print on the camera; if it looks fine, resume.</string>
    <string name="fault_104_title">AI camera: foreign object on the bed</string>
    <string name="fault_104_what">Before printing the camera saw something on the bed (a leftover part, a tool).</string>
    <string name="fault_104_todo">Clear the bed and start the print again.</string>
    <string name="fault_115_title">Print interrupted by a power loss</string>
    <string name="fault_115_what">The printer found an unfinished print — power was lost.</string>
    <string name="fault_115_todo">On the printer screen you can resume the print or discard it.</string>
    <string name="fault_116_title">Filament runout</string>
    <string name="fault_116_what">The filament sensor at the extruder no longer detects filament — the print is paused.</string>
    <string name="fault_116_todo">The spool ran out, or the filament broke or tangled before the sensor. Load filament and resume the print.</string>
    <string name="fault_122_title">Couldn\'t start a CFS print</string>
    <string name="fault_122_what">The printer couldn\'t prepare the CFS for printing.</string>
    <string name="fault_122_todo">Check that the box is connected, spools are assigned and filament is loaded, then start again.</string>
    <string name="fault_528_title">CFS: printing with no filament</string>
    <string name="fault_528_what">Filament from the box doesn\'t reach the nozzle — the printer is printing air.</string>
    <string name="fault_2005_title">Bed probing failed</string>
    <string name="fault_2005_what">Probing was aborted: Klipper shut down.</string>
    <string name="fault_restart_klipper_retry">Restart Klipper (Firmware Restart) and try again.</string>
    <string name="fault_2022_title">Endstop not triggered</string>
    <string name="fault_2022_what">During homing the axis travelled its full length but the endstop didn\'t trigger.</string>
    <string name="fault_2022_todo">Check that nothing blocks the motion and check the endstop/sensor connector.</string>
    <string name="fault_2060_title">Internal firmware error</string>
    <string name="fault_2060_what">A G-code command caused a failure — Klipper is shut down.</string>
    <string name="fault_restart_klipper">Restart Klipper (Firmware Restart).</string>
    <string name="fault_2096_title">Axes must be homed</string>
    <string name="fault_2096_what">This command requires homing (G28) first.</string>
    <string name="fault_2096_todo">Home the axes and try again.</string>
    <string name="fault_2111_title">Cold extrusion</string>
    <string name="fault_2111_what">The nozzle is below the minimum extrusion temperature (usually 170°).</string>
    <string name="fault_2111_todo">Heat the nozzle and try again.</string>
    <string name="fault_2112_title">Extrusion too large</string>
    <string name="fault_2112_what">The extruder move exceeds the allowed cross-section — usually a G-code problem.</string>
    <string name="fault_2112_todo">Re-slice the model; check line widths and the nozzle diameter.</string>
    <string name="fault_mcu_title">Toolhead board (MCU) failure</string>
    <string name="fault_mcu_what">Klipper didn\'t send commands to the toolhead board in time — a safety check stopped the print.</string>
    <string name="fault_2353_todo">Restart the printer. If it repeats, reduce the printer load (camera, AI) and check the toolhead cable.</string>
    <string name="fault_2355_todo">Restart the printer. If it repeats, check the toolhead cable.</string>
    <string name="fault_2509_title">Nozzle temperature sensor out of range</string>
    <string name="fault_2509_what">The nozzle thermistor reads an impossible temperature — an open or short circuit.</string>
    <string name="fault_2509_todo">Turn the printer off and check the thermistor connector on the toolhead.</string>
    <string name="fault_2564_title">Nozzle isn\'t heating</string>
    <string name="fault_2564_what">The nozzle heater heats slower than expected — thermal protection stopped the print.</string>
    <string name="fault_2564_todo">Check the heater and thermistor connectors. A draft or a removed nozzle shroud can also cause this.</string>
    <string name="fault_2585_title">Move out of range</string>
    <string name="fault_2585_what">A command moves the head outside the print area.</string>
    <string name="fault_2585_todo">Check the model and the printer preset in the slicer.</string>
    <string name="fault_2784_title">Motor driver: overcurrent</string>
    <string name="fault_2784_what">A stepper driver detected sustained overcurrent.</string>
    <string name="fault_2784_todo">Turn the printer off and check that the axes move freely.</string>
    <string name="fault_2789_title">Motor driver: lost steps</string>
    <string name="fault_2789_what">A motor fell behind its target position (closed loop).</string>
    <string name="fault_2789_todo">Check that the head isn\'t blocked and the belts don\'t catch.</string>
    <string name="fault_2796_title">Low motor supply voltage</string>
    <string name="fault_2796_todo">Check the printer\'s power supply; if it repeats, contact support.</string>
    <string name="fault_2798_title">No connection to a motor</string>
    <string name="fault_2798_what">The board couldn\'t connect to a motor driver.</string>
    <string name="fault_2798_todo">Restart the printer; if it repeats, check the motor connectors.</string>
    <string name="fault_2831_title">CFS: no connection to the box</string>
    <string name="fault_2831_what">The RS-485 bus to the box doesn\'t respond.</string>
    <string name="fault_2831_todo">Check the box cable and restart the printer.</string>
    <string name="fault_2834_title">CFS: command error</string>
    <string name="fault_restart_printer">Restart the printer.</string>
    <string name="fault_2835_title">CFS: jam at the connector</string>
    <string name="fault_2835_what">The filament doesn\'t pass the connector (hub) at the box outlet.</string>
    <string name="fault_2836_title">CFS: filament didn\'t reach the sensor</string>
    <string name="fault_2836_what">The filament left the box but didn\'t reach the toolhead sensor — a jam in the tube.</string>
    <string name="fault_2837_title">CFS: jam at the extruder</string>
    <string name="fault_2837_what">The filament reached the sensor but the extruder gears don\'t grip it.</string>
    <string name="fault_2837_todo">Check the extruder inlet and the filament tip (cut it at an angle).</string>
    <string name="fault_2838_title">CFS: filament isn\'t feeding</string>
    <string name="fault_2838_what">The filament passed the connector but doesn\'t feed further.</string>
    <string name="fault_2839_title">CFS: no filament at the feed position</string>
    <string name="fault_2839_what">The box doesn\'t detect filament in the selected slot.</string>
    <string name="fault_2839_todo">Push the filament into the slot until it clicks, or pick another spool.</string>
    <string name="fault_2840_title">CFS: slot switch error</string>
    <string name="fault_2840_todo">Check the box and try again; if it repeats, restart the printer.</string>
    <string name="fault_2841_title">Filament cut error</string>
    <string name="fault_2841_what">The cutter didn\'t return after cutting.</string>
    <string name="fault_2841_todo">Check the cutter on the toolhead for a stuck piece of filament.</string>
    <string name="fault_2843_title">CFS: RFID read error</string>
    <string name="fault_2843_what">The spool tag couldn\'t be read.</string>
    <string name="fault_2843_todo">Set the slot\'s filament manually (Control tab → Spools).</string>
    <string name="fault_2844_title">CFS: pneumatic connector</string>
    <string name="fault_2844_what">A tube connector isn\'t working properly and may collapse.</string>
    <string name="fault_2844_todo">Check that the tubes are seated in the connectors.</string>
    <string name="fault_2845_title">Nozzle clog</string>
    <string name="fault_2845_what">Filament doesn\'t come out of the nozzle.</string>
    <string name="fault_2845_todo">Clean the nozzle (heat, extrude, use a needle or a cold pull if needed).</string>
    <string name="fault_2846_title">Printing with no filament: CFS too slow</string>
    <string name="fault_2846_what">The box feeds filament slower than the extruder uses it.</string>
    <string name="fault_2846_todo">Check whether the spool drags (tangles, friction) and check the filament path.</string>
    <string name="fault_2847_title">Printing with no filament: tangled spool</string>
    <string name="fault_2847_what">The filament is tangled on the spool and doesn\'t feed.</string>
    <string name="fault_2847_todo">Untangle the spool and resume the print.</string>
    <string name="fault_2848_title">CFS: filament may be broken at the connector</string>
    <string name="fault_2849_title">CFS: couldn\'t unload filament</string>
    <string name="fault_2849_what">The filament didn\'t leave the connector during a color change.</string>
    <string name="fault_2849_todo">Pull the filament out by hand and check the tip (a swollen tip gets stuck).</string>
    <string name="fault_unload_title">CFS: unload error</string>
    <string name="fault_2850_what">Several connectors triggered at the same time.</string>
    <string name="fault_2850_todo">Check that there are no stray pieces of filament in the tubes.</string>
    <string name="fault_2851_what">The buffer didn\'t empty while unloading.</string>
    <string name="fault_2852_title">Check the filament sensors</string>
    <string name="fault_2852_what">The extruder and box sensors disagree.</string>
    <string name="fault_2852_todo">Make sure there\'s no broken piece of filament in the toolhead.</string>
    <string name="fault_2853_title">CFS: humidity sensor</string>
    <string name="fault_restart_or_support">Restart the printer; if it repeats, contact support.</string>
    <string name="fault_2854_title">Filament detected while cutting</string>
    <string name="fault_2854_what">The sensor still detects filament during the cut.</string>
    <string name="fault_2854_todo">Check the cutter and remove scraps from the toolhead.</string>
    <string name="fault_2855_title">Cutter position error</string>
    <string name="fault_2855_todo">Check the filament cutter on the toolhead.</string>
    <string name="fault_2856_title">Cutter not found</string>
    <string name="fault_2856_todo">Check that the cutter is installed.</string>
    <string name="fault_2857_title">CFS: motor load error</string>
    <string name="fault_2857_todo">Check whether the spool is stuck.</string>
    <string name="fault_2858_title">CFS: box memory error</string>
    <string name="fault_2859_title">CFS: measuring wheel error</string>
    <string name="fault_2859_what">The wheel that measures filament length doesn\'t turn.</string>
    <string name="fault_2859_todo">Check the wheel for dust and scraps.</string>
    <string name="fault_2860_title">CFS: buffer error</string>
    <string name="fault_2861_title">CFS: RFID error (left reader)</string>
    <string name="fault_2862_title">CFS: RFID error (right reader)</string>
    <string name="fault_2863_title">CFS: filament didn\'t leave the toolhead</string>
    <string name="fault_2863_what">Unloading finished but the toolhead sensor still detects filament.</string>
    <string name="fault_2863_todo">Check whether filament broke off inside the toolhead.</string>
    <string name="fault_2864_title">CFS: filament didn\'t reach the buffer</string>
    <string name="fault_2865_todo">Pull the filament out by hand and check the tip.</string>
    <string name="fault_2870_title">CFS drying: heating takes too long</string>
    <string name="fault_2870_todo">Close the box lid and run drying again.</string>
    <string name="fault_2871_title">CFS drying: overheating</string>
    <string name="fault_2871_todo">Stop drying; if it repeats, contact support.</string>
    <string name="fault_2872_title">CFS: dryer heater fault</string>
    <string name="fault_2873_title">CFS: dryer temperature sensor fault</string>
    <string name="fault_2874_title">CFS: dryer fan fault</string>
    <string name="fault_2875_title">CFS: dryer heater isn\'t plugged in</string>
    <string name="fault_2875_todo">Connect power to the box dryer.</string>
    <string name="fault_3000_title">Klipper disconnected</string>
    <string name="fault_3000_what">The Creality services lost the connection to Klipper.</string>
    <string name="fault_3002_title">Klipper configuration error</string>
    <string name="fault_3002_what">printer.cfg references a missing file or has an error.</string>
    <string name="fault_3002_todo">Fix the configuration in Fluidd and restart.</string>
