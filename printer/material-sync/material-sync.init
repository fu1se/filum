#!/bin/sh /etc/rc.common
# Пластики orca-sync → библиотека материалов K2 (OpenWrt procd).
# Установка: cp material-sync.init /etc/init.d/material-sync && /etc/init.d/material-sync enable && /etc/init.d/material-sync start

START=99
USE_PROCD=1
DEPEND=fstab

DIR=/mnt/UDISK/material-sync

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 $DIR/material_sync.py
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
